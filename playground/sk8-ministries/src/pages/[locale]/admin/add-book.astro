---
export function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "ne" } },
    { params: { locale: "de" } },
  ]
}

const { locale } = Astro.params
const currentLocale = locale || "en"
---

<html
  lang={currentLocale}
  style="height: 100%; background-color: #f8fafc; font-family: ui-sans-serif, system-ui, sans-serif;"
>
  <head>
    <meta charset="utf-8" />
    <title>Library Admin Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    style="min-height: 100%; margin: 0; background-color: #f8fafc; color: #0f172a;"
  >
    <!-- Admin Header -->
    <header
      style="position: sticky; top: 0; z-index: 50; display: flex; height: 4rem; width: 100%; align-items: center; justify-content: space-between; border-bottom: 1px solid #e2e8f0; background-color: #ffffff; padding: 0 1.5rem; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);"
    >
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <div
          style="display: flex; height: 2.5rem; width: 2.5rem; align-items: center; justify-content: center; border-radius: 0.75rem; background-color: #f97316; color: #ffffff; box-shadow: 0 4px 6px -1px rgba(249, 115, 22, 0.2);"
        >
          <svg
            style="height: 1.25rem; width: 1.25rem;"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
        </div>
        <span
          style="font-size: 1.125rem; font-weight: 700; letter-spacing: -0.025em;"
          >Library Admin Dashboard ({currentLocale.toUpperCase()})</span
        >
      </div>

      <div style="display: flex; align-items: center; gap: 1rem;">
        <a
          href={`/${currentLocale}`}
          style="border-radius: 0.5rem; padding: 0.5rem 1rem; background-color: #f1f5f9; font-size: 0.875rem; font-weight: 600; color: #334155; text-decoration: none;"
        >
          View Live Site
        </a>
      </div>
    </header>

    <!-- Main Dashboard Content -->
    <main style="max-width: 56rem; margin: 3rem auto; padding: 0 1rem;">
      <div
        style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;"
      >
        <div>
          <h1
            style="font-size: 1.875rem; font-weight: 800; letter-spacing: -0.025em; color: #0f172a; margin: 0 0 0.5rem 0;"
          >
            Manage Library Books
          </h1>
          <p style="color: #64748b; font-size: 0.95rem; margin: 0;">
            Add, edit, or remove books from your multi-lingual digital library
            collection.
          </p>
        </div>

        <!-- Connected Link to Sveltia Admin Book Entry Form -->
        <a
          href="/admin/#/collections/books/new"
          style="display: inline-flex; align-items: center; gap: 0.5rem; border-radius: 0.75rem; background-color: #f97316; padding: 0.75rem 1.25rem; font-size: 0.875rem; font-weight: 700; color: #ffffff; text-decoration: none; box-shadow: 0 4px 6px -1px rgba(249, 115, 22, 0.2);"
        >
          <svg
            style="height: 1.25rem; width: 1.25rem;"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"></path>
          </svg>
          Add a New Book
        </a>
      </div>

      <!-- Overview Card / Stats Container -->
      <div
        style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 2rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);"
      >
        <h2
          style="font-size: 1.25rem; font-weight: 700; color: #0f172a; margin-top: 0; margin-bottom: 1rem;"
        >
          Quick Actions
        </h2>
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;"
        >
          <a
            href="/admin/#/collections/books/new"
            style="display: block; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 1.25rem; text-decoration: none; background-color: #f8fafc; transition: border-color 0.2s;"
          >
            <h3
              style="font-size: 1rem; font-weight: 600; color: #0f172a; margin: 0 0 0.25rem 0;"
            >
              Upload New Book
            </h3>
            <p style="font-size: 0.85rem; color: #64748b; margin: 0;">
              Upload PDF or EPUB files with cover images.
            </p>
          </a>
        </div>
      </div>
    </main>
  </body>
</html>
