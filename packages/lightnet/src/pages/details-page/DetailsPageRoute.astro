---
import { getCollection } from "astro:content"

import DefaultDetailsPage from "./DefaultDetailsPage.astro"

export async function getStaticPaths() {
  const mediaEntries = await getCollection("media")

  return mediaEntries.map((entry) => {
    // Always use entry.slug or strip the file extension cleanly
    const slug = (entry.slug || entry.id).replace(/\.[^/.]+$/, "")
    const locale = slug.endsWith("-ne") ? "ne" : "en"

    return {
      params: { locale, mediaId: slug },
      props: { mediaId: slug },
    }
  })
}

const { locale, mediaId } = Astro.params

// 1. Fetch all media entries
const allMediaEntries = await getCollection("media")

// 2. Clean the incoming mediaId
const cleanMediaId = mediaId.replace(/\.[^/.]+$/, "")

// 3. Compute the alternate slug (-en <-> -ne)
let alternateSlug = cleanMediaId
if (cleanMediaId.endsWith("-en")) {
  alternateSlug = cleanMediaId.slice(0, -3) + "-ne"
} else if (cleanMediaId.endsWith("-ne")) {
  alternateSlug = cleanMediaId.slice(0, -3) + "-en"
}

// 4. Check if the alternate entry exists in the collection
const alternateExists = allMediaEntries.some((entry) => {
  const entrySlug = (entry.slug || entry.id).replace(/\.[^/.]+$/, "")
  return entrySlug === alternateSlug
})

// 5. Build the correct localized target URL
const alternateLocale = locale === "en" ? "ne" : "en"
const targetUrl = alternateExists
  ? `/${alternateLocale}/media/${alternateSlug}`
  : undefined
---

<DefaultDetailsPage mediaId={cleanMediaId} targetUrl={targetUrl} />
