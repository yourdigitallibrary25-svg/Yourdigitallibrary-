---
import { ChevronDownIcon, DownloadIcon, ExternalLinkIcon } from "lucide-react"

import { getMediaItem } from "../../../../content/get-media-items"
import { getMediaType } from "../../../../content/get-media-types"
import { getLinkAttributes } from "../../../../utils/link-attributes"
import { createContentMetadata } from "../../utils/create-content-metadata"

interface Props {
  mediaId: string
  className?: string
}

const { mediaId, className } = Astro.props
const { tContentField, t } = Astro.locals.i18n
const item = await getMediaItem(mediaId)

const contentItems = item.data.content || []
const primaryContent = contentItems[0] || {}

// Explicitly match PDF and EPUB formats by format key or URL file extension
const pdfItem = contentItems.find(
  (c: any) => c.format === "pdf" || c.url?.toLowerCase().endsWith(".pdf"),
)
const epubItem = contentItems.find(
  (c: any) => c.format === "epub" || c.url?.toLowerCase().endsWith(".epub"),
)

const pdfUrl = pdfItem?.url || primaryContent.url
const epubUrl = epubItem?.url || primaryContent.url

const content = createContentMetadata({
  url: primaryContent.url,
  labelText: primaryContent.label && tContentField(primaryContent.label, item),
})
const mediaType = await getMediaType(item.data.type.id)

const getOpenActionLabel = () => {
  const defaultLabel = t("ln.details.open") || t("read") || "Read"
  if (mediaType.data.detailsPage?.layout !== "default") {
    return defaultLabel
  }
  if (!mediaType.data.detailsPage.openActionLabel) {
    return defaultLabel
  }
  return tContentField(mediaType.data.detailsPage.openActionLabel, mediaType)
}

// Translation resolution for Read & Download
const downloadLabel = t("ln.details.download") || t("download") || "Download"
const readLabel = getOpenActionLabel()
---

<div class="flex items-center gap-3" class:list={[className]}>
  {/* Read / Open Action Button */}
  <a
    class="flex w-44 items-center justify-center gap-2 rounded-2xl bg-gray-800 px-4 py-3 font-bold text-gray-100 shadow-sm hover:bg-gray-950 hover:text-gray-300"
    {...getLinkAttributes(content.url)}
    hreflang={item.data.language}
  >
    {
      content.isExternal && (
        <ExternalLinkIcon className="shrink-0 rtl:scale-x-[-1]" />
      )
    }
    {content.isDownload ? downloadLabel : readLabel}
  </a>

  {/* Dropdown Container */}
  <details class="group relative inline-block w-44">
    <summary
      class="flex w-full cursor-pointer list-none items-center justify-center gap-2 rounded-2xl border-2 border-gray-800 bg-transparent px-4 py-3 font-bold text-gray-800 shadow-sm hover:bg-gray-800 hover:text-gray-100 dark:border-gray-200 dark:text-gray-200 dark:hover:bg-gray-800 dark:hover:text-gray-900 [&::-webkit-details-marker]:hidden"
    >
      <DownloadIcon class="shrink-0" />
      <span>{downloadLabel}</span>
      <ChevronDownIcon
        class="h-4 w-4 transition-transform group-open:rotate-180"
      />
    </summary>

    {/* Vertical Dropdown Options */}
    <div
      class="absolute left-0 right-0 top-full z-30 mt-2 flex flex-col overflow-hidden rounded-2xl border-2 border-gray-800 bg-white shadow-lg dark:border-gray-200 dark:bg-gray-900"
    >
      <a
        href={pdfUrl}
        download
        data-pdf-download
        class="block w-full border-b border-gray-200 px-6 py-2.5 text-center font-bold text-gray-800 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800"
      >
        PDF
      </a>
      <a
        href={epubUrl}
        download
        class="block w-full px-6 py-2.5 text-center font-bold text-gray-800 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800"
      >
        EPUB
      </a>
    </div>
  </details>
</div>

<script>
  function handlePdfDownloads() {
    const pdfLinks = document.querySelectorAll<HTMLAnchorElement>(
      "a[data-pdf-download]",
    )

    pdfLinks.forEach((link) => {
      // Prevent attaching duplicate event listeners
      if (link.dataset.downloadHandled === "true") return
      link.dataset.downloadHandled = "true"

      link.addEventListener("click", async (e) => {
        const fileUrl = link.getAttribute("href")
        if (!fileUrl) return

        // Check for iOS devices
        const isIOS =
          /iPad|iPhone|iPod/.test(navigator.userAgent) ||
          (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1)

        if (isIOS) {
          e.preventDefault()

          try {
            const response = await fetch(fileUrl)
            const blob = await response.blob()
            const blobUrl = URL.createObjectURL(blob)

            // Create temporary anchor to trigger blob download prompt on iOS Safari
            const tempLink = document.createElement("a")
            tempLink.href = blobUrl
            tempLink.download = fileUrl.split("/").pop() || "book.pdf"
            document.body.appendChild(tempLink)
            tempLink.click()
            document.body.removeChild(tempLink)

            setTimeout(() => URL.revokeObjectURL(blobUrl), 10000)
          } catch {
            // Fallback to direct navigation if fetch fails (e.g. CORS)
            window.location.href = fileUrl
          }
        }
      })
    })
  }

  handlePdfDownloads()
  document.addEventListener("astro:page-load", handlePdfDownloads)
  document.addEventListener("astro:after-swap", handlePdfDownloads)
</script>
