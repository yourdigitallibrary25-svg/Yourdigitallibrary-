---
interface Props {
  label: string
}

const { label } = Astro.props
const { t } = Astro.locals.i18n
---

<div class="relative inline-block text-left" id="main-menu-wrapper">
  <button
    type="button"
    id="main-menu-btn"
    onclick="event.stopPropagation(); event.stopImmediatePropagation(); const d = document.getElementById('main-menu-dropdown'); if(d){ d.classList.toggle('hidden'); }"
    class="flex items-center justify-center p-3 text-gray-600 hover:text-primary focus:outline-none dark:text-gray-300 dark:hover:text-white"
    aria-label={t(label)}
    aria-expanded="false"
  >
    <slot name="icon" />
  </button>

  <div
    id="main-menu-dropdown"
    class="absolute right-0 z-50 mt-2 hidden w-48 rounded-lg border border-gray-200 bg-white py-1 text-gray-900 shadow-xl dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100"
  >
    <slot />
  </div>
</div>

<script>
  const setupOutsideClick = () => {
    document.addEventListener("click", (e) => {
      const btn = document.getElementById("main-menu-btn")
      const dropdown = document.getElementById("main-menu-dropdown")
      if (!btn || !dropdown) return

      const target = e.target as Node
      if (!btn.contains(target) && !dropdown.contains(target)) {
        dropdown.classList.add("hidden")
      }
    })
  }

  setupOutsideClick()
  document.addEventListener("astro:page-load", setupOutsideClick)
</script>
