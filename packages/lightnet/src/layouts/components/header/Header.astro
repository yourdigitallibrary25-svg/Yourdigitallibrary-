---
import PageNavigation from "./PageNavigation.astro"
import PageTitle from "./PageTitle.astro"
---

<header
  class="fixed top-0 z-50 h-14 w-full border-b border-gray-200 bg-white shadow-md transition-colors duration-200 sm:h-20 dark:border-gray-800 dark:bg-gray-900"
>
  {
    /* mx-auto centers the container with your book grid, and justify-between pushes items to the outer left/right borders */
  }
  <div
    class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <PageTitle />
    <PageNavigation />
  </div>
</header>
